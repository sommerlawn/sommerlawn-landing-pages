---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ValueProps from '../components/ValueProps.astro';
import Testimonials from '../components/Testimonials.astro';
import SignupForm from '../components/SignupForm.astro';
import Footer from '../components/Footer.astro';

const leafValueProps = [
  {
    icon: '💰',
    title: 'Transparent Pricing',
    feature: '$190 minimum includes first man-hour + dump fee.',
    benefit: 'No surprise bills. Additional time is $75/man-hour, and the total is always based on actual time spent — nothing more.',
  },
  {
    icon: '🏡',
    title: 'Full-Service Cleanup',
    feature: 'Front yard, backyard, and all landscape beds.',
    benefit: 'We don\'t just blow leaves around. Our standard service covers your entire property so nothing gets missed.',
  },
  {
    icon: '⚡',
    title: 'Same-Day Availability',
    feature: 'Fast turnaround when you need it.',
    benefit: 'We know leaves don\'t wait. We frequently fit jobs in same-day so your yard doesn\'t sit buried all week.',
  },
  {
    icon: '🚛',
    title: 'Curbside Pickup Option',
    feature: 'Starting at $85 for piles up to 20 feet.',
    benefit: 'Already raked your leaves to the curb? We\'ll haul them away for you at a lower price point.',
  },
  {
    icon: '🎯',
    title: 'Flexible Scope',
    feature: 'Choose which areas we service.',
    benefit: 'On a budget? We can focus on just the front yard or skip the beds — you choose the scope that works for you.',
  },
];

const leafTestimonials = [
  {
    quote: 'The crew did a great job! They were able to come within the same day of the request and had all of the leaves cleaned up in less than 30 minutes or so! Very appreciative of their work.',
    name: 'Logan J.',
    stars: 5,
  },
  {
    quote: 'Prompt response and very punctual in completing the work requested. Cayden was extremely helpful in squeezing the job in on the Holiday week of Thanksgiving. Highly recommend the lawn service!!!',
    name: 'John Peter S.',
    stars: 5,
  },
];
---

<Layout
  title="Leaf Removal Service | Sommer Lawn & Landscape"
  description="Professional leaf removal for your yard. Full-service cleanup or curbside pickup — fast, thorough, and hassle-free."
>
  <Hero
    image="/leaf-truck.jpeg"
    video="/leaf-b-roll.mov"
    imagePosition="object-center"
    imageAlt="Sommer Lawn truck loaded with leaves after a cleanup"
    headline="Leaf Removal"
    subtitle="Full-service cleanup or curbside pickup — fast, thorough, and hassle-free. We handle the leaves so you don't have to."
    personalizedHeadline={`Hey {name}! Check out <span class="text-smurf">Sommer Lawn</span>'s leaf removal service!`}
  />

  <!-- Pricing Section -->
  <section class="bg-dark px-6 py-20">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-3">Pricing</h2>
      <p class="text-gray-400 text-center text-lg mb-12">Simple, transparent pricing — no surprises.</p>

      <!-- Two service cards -->
      <div class="grid md:grid-cols-2 gap-8 mb-8">

        <!-- Full Service Leaf Cleanup -->
        <div class="bg-dark-card border border-dark-border rounded-2xl overflow-hidden flex flex-col">
          <div class="bg-smurf px-6 py-4 text-center">
            <h3 class="text-white font-extrabold text-xl uppercase tracking-wide leading-tight">Full Service<br>Leaf Cleanup</h3>
          </div>
          <div class="p-8 flex flex-col flex-1">
            <div class="text-center mb-6">
              <p class="text-4xl font-extrabold text-white">$190 Minimum</p>
              <p class="text-gray-400 mt-1">Includes 1 man-hour &middot; Then $75/hr</p>
            </div>
            <div class="border-t border-dark-border pt-6 mb-6">
              <p class="text-gray-300 italic text-sm text-center leading-relaxed">We take care of everything! We collect the leaves, haul off the debris, and make sure your lawn looks great.</p>
            </div>
            <ul class="space-y-4">
              <li class="flex items-start gap-3 text-gray-300">
                <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
                Everything included — no dump fees
              </li>
              <li class="flex items-start gap-3 text-gray-300">
                <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
                Optional price cap so you never go over a set amount
              </li>
              <li class="flex items-start gap-3 text-gray-300">
                <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
                $190 covers the first man-hour, then $75 each additional
              </li>
            </ul>
          </div>
        </div>

        <!-- Curbside Pickup -->
        <div class="bg-dark-card border border-dark-border rounded-2xl overflow-hidden flex flex-col">
          <div class="bg-smurf px-6 py-4 text-center">
            <h3 class="text-white font-extrabold text-xl uppercase tracking-wide leading-tight">Curbside<br>Pickup</h3>
          </div>
          <div class="p-8 flex flex-col flex-1">
            <div class="text-center mb-6">
              <p class="text-4xl font-extrabold text-white">$85</p>
              <p class="text-gray-400 mt-1">For most size piles</p>
            </div>
            <div class="border-t border-dark-border pt-6 mb-6">
              <p class="text-gray-300 italic text-sm text-center leading-relaxed">Simply blow your leaves within 10&rsquo; of the curb and we&rsquo;ll take care of the rest!</p>
            </div>
            <ul class="space-y-4">
              <li class="flex items-start gap-3 text-gray-300">
                <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
                <span><span class="text-white font-semibold">$85</span> &mdash; small piles, 0&ndash;20ft long</span>
              </li>
              <li class="flex items-start gap-3 text-gray-300">
                <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
                <span><span class="text-white font-semibold">$150</span> &mdash; medium piles, 20&ndash;60ft long</span>
              </li>
              <li class="flex items-start gap-3 text-gray-300">
                <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
                <span><span class="text-white font-semibold">$275</span> &mdash; large piles, 60&ndash;100ft long</span>
              </li>
              <li class="flex items-start gap-3 text-gray-300">
                <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
                Custom pricing for piles over 100ft long
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Multi-cleanup discount banner -->
      <div class="bg-dark-card border border-smurf/30 rounded-2xl p-8 text-center">
        <p class="text-smurf font-bold uppercase tracking-widest text-sm mb-2">Multi-Cleanup Discount</p>
        <h3 class="text-4xl md:text-5xl font-extrabold text-white mb-3">Get $100 Off!</h3>
        <p class="text-gray-400 mb-8">When you sign up for multiple full-service leaf cleanups</p>
        <div class="grid grid-cols-3 gap-4">
          <div class="bg-dark border border-dark-border rounded-xl p-4">
            <p class="text-white font-bold text-lg mb-1">2 Cleanups</p>
            <p class="text-smurf font-semibold">$15 off each</p>
            <p class="text-gray-500 text-sm mt-1">$30 total savings</p>
          </div>
          <div class="bg-dark border border-smurf/40 rounded-xl p-4 ring-1 ring-smurf/20">
            <p class="text-white font-bold text-lg mb-1">3 Cleanups</p>
            <p class="text-smurf font-semibold">$20 off each</p>
            <p class="text-gray-500 text-sm mt-1">$60 total savings</p>
          </div>
          <div class="bg-dark border border-dark-border rounded-xl p-4">
            <p class="text-white font-bold text-lg mb-1">4 Cleanups</p>
            <p class="text-smurf font-semibold">$25 off each</p>
            <p class="text-gray-500 text-sm mt-1">$100 total savings</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ValueProps
    title="Why Choose Sommer Lawn?"
    subtitle="Transparent pricing, flexible options, and a crew that gets the job done right."
    items={leafValueProps}
  />

  <!-- Photo break -->
  <div class="relative h-64 md:h-80 lg:h-96 overflow-hidden">
    <img src="/leaf-truck.jpeg" alt="Sommer Lawn truck loaded with leaves after a cleanup" class="w-full h-full object-cover object-center" />
    <div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-transparent to-dark/30"></div>
  </div>

  <Testimonials testimonials={leafTestimonials} />

  <SignupForm />

  <!-- Full-width photo break -->
  <div class="relative h-64 md:h-80 lg:h-96 overflow-hidden">
    <img src="/curbside.png" alt="Sommer Lawn curbside leaf pickup" class="w-full h-full object-cover object-center" />
    <div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-transparent to-dark/30"></div>
  </div>

  <!-- More Services -->
  <section class="bg-dark-card px-6 py-16 text-center">
    <p class="text-gray-400 text-lg mb-4">We do more than leaf removal.</p>
    <a href="/services" class="text-smurf font-semibold text-lg hover:text-smurf-light transition-colors">
      View All Services &rarr;
    </a>
  </section>

  <Footer />

  <!-- Spring Promo Popup (only shown when URL params present) -->
  <div id="promo-popup" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="promo-backdrop"></div>
    <div class="relative bg-dark-card border border-smurf-blue/40 rounded-2xl p-6 max-w-sm w-full shadow-2xl shadow-smurf-blue/10 text-center">
      <button id="promo-close" class="absolute top-4 right-4 text-gray-400 hover:text-white transition-colors text-xl leading-none">&times;</button>
      <div class="text-5xl mb-3">🍃</div>
      <div class="inline-block bg-smurf-blue/20 border border-smurf-blue/40 text-smurf text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
        Limited Time Offer
      </div>
      <h2 class="text-3xl font-extrabold text-white mb-2">$25 Off</h2>
      <p class="text-gray-300 text-sm mb-5">Spring promo — use this code when you book your leaf removal service.</p>
      <div class="bg-dark border border-dark-border rounded-xl px-6 py-4 mb-5">
        <p class="text-xs text-gray-500 uppercase tracking-widest mb-1">Promo Code</p>
        <p class="text-xl font-mono font-bold text-smurf tracking-wider">LEAF-SPRING-2026</p>
        <p class="text-xs text-gray-500 mt-2">Expires April 1, 2026</p>
      </div>
      <button id="promo-dismiss" class="w-full bg-smurf-blue hover:bg-smurf-blue/80 text-white font-bold py-3 rounded-xl transition-colors">
        Got it — save my $25!
      </button>
    </div>
  </div>

  <!-- Minimized promo tab -->
  <button
    id="promo-tab"
    class="fixed bottom-4 left-4 z-50 hidden items-center gap-2 bg-dark-card border border-smurf-blue/40 text-white text-sm font-bold px-4 py-3 rounded-2xl shadow-lg shadow-smurf-blue/10 active:scale-95 transition-transform"
  >
    <span class="text-lg">🍃</span>
    <span>$25 off — tap to view</span>
  </button>

  <script>
    const hasParams = window.location.search.length > 1;
    if (hasParams) {
      const popup = document.getElementById('promo-popup');
      const tab = document.getElementById('promo-tab');

      const open = () => {
        popup?.classList.remove('hidden');
        tab?.classList.remove('flex');
        tab?.classList.add('hidden');
      };

      const minimize = () => {
        popup?.classList.add('hidden');
        tab?.classList.remove('hidden');
        tab?.classList.add('flex');
      };

      setTimeout(() => popup?.classList.remove('hidden'), 2500);

      document.getElementById('promo-close')?.addEventListener('click', minimize);
      document.getElementById('promo-dismiss')?.addEventListener('click', minimize);
      document.getElementById('promo-backdrop')?.addEventListener('click', minimize);
      tab?.addEventListener('click', open);
    }
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';

export function getStaticPaths() {
  const cities = [
    {
      slug: 'prairie-village',
      name: 'Prairie Village',
      blurb: 'We know Prairie Village neighborhoods well — from Mission Road to Tomahawk Creek, your lawn is in good hands.',
    },
    {
      slug: 'mission-hills',
      name: 'Mission Hills',
      blurb: 'Mission Hills properties deserve first-rate care. We deliver the reliability and attention to detail your home requires.',
    },
    {
      slug: 'fairway',
      name: 'Fairway',
      blurb: "Fairway is a tight-knit community — and we treat every yard like it's our neighbor's. Consistent, dependable service all season.",
    },
    {
      slug: 'mission',
      name: 'Mission',
      blurb: 'From weekly mowing to seasonal cleanup, we keep Mission lawns looking sharp without the hassle.',
    },
    {
      slug: 'roeland-park',
      name: 'Roeland Park',
      blurb: "Roeland Park homeowners trust us for reliable, no-drama lawn care. We show up when we say we will — every time.",
    },
    {
      slug: 'overland-park',
      name: 'Overland Park',
      blurb: "Overland Park is our biggest service area, and we're proud to keep hundreds of OP lawns healthy and green year-round.",
    },
    {
      slug: 'leawood',
      name: 'Leawood',
      blurb: "Leawood's beautiful properties deserve meticulous care. We bring the same precision and professionalism to every visit.",
    },
    {
      slug: 'olathe',
      name: 'Olathe',
      blurb: "Olathe is home base for Sommer Lawn. We're local, we're invested, and we're here to take lawn care off your plate for good.",
    },
  ];

  return cities.map(({ slug, name, blurb }) => ({
    params: { city: slug },
    props: { name, slug, blurb },
  }));
}

const { name, blurb } = Astro.props;

const services = [
  {
    icon: '🏡',
    title: 'Mowing',
    description: 'Weekly or bi-weekly mowing, trimming, edging, and blowing — same crew, sharp results, all season long.',
    href: '/mowing',
  },
  {
    icon: '🌿',
    title: 'Bed Maintenance',
    description: 'Weed pulling, shrub trimming, and bed cleanup to keep your landscaping looking its best.',
  },
  {
    icon: '🪵',
    title: 'Mulch Installation',
    description: 'Fresh mulch delivered and installed — clean edges, weed suppression, and instant curb appeal.',
  },
  {
    icon: '🌳',
    title: 'Tree Pruning',
    description: "Professional pruning for trees up to 20'. Healthier trees, cleaner sight lines, safer property.",
  },
  {
    icon: '🍂',
    title: 'Leaf Removal',
    description: "Full-service cleanup or curbside pickup — we handle the leaves so you don't have to.",
    href: '/leaf-removal',
  },
  {
    icon: '❄️',
    title: 'Snow Removal',
    description: "Driveways, sidewalks, and walkways cleared fast so you're never stuck after a storm.",
  },
];

const differentiators = [
  {
    icon: '✅',
    title: 'Actually Reliable',
    description: 'We show up when we say we will. If something ever changes, we reach out — you\'re never left wondering where your crew is.',
  },
  {
    icon: '🤝',
    title: 'One Crew, All Season',
    description: 'Your same crew handles mowing, leaves, and snow. They know your property — no re-explaining every visit.',
  },
  {
    icon: '📱',
    title: 'Easy to Work With',
    description: 'Text us, call us, or fill out a form. Fast responses, straightforward pricing, and no-hassle billing.',
  },
];
---

<Layout
  title={`Lawn Care in ${name}, KS | Sommer Lawn & Landscape`}
  description={`Reliable lawn care and landscape services in ${name}, KS. Mowing, leaf removal, mulch, snow removal, and more. Same crew. Honest pricing. ${blurb}`}
>

  <Nav />

  <Hero
    image="/truck+mower.jpeg"
    video="/general-b-roll(edited).mp4"
    imagePosition="object-center"
    imageAlt={`Sommer Lawn crew serving ${name}, KS`}
    prefixText=""
    highlightText="Lawn Care in"
    headline={`${name}, KS`}
    subtitle={blurb}
    ctaText="Get a Free Quote"
    ctaHref="#contact"
  />

  <!-- Services -->
  <section id="services" class="bg-dark-card px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Everything Your Property Needs</h2>
        <p class="text-gray-400 text-lg">One company. One crew. Every season.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="bg-dark border border-dark-border rounded-xl p-8 transition-colors hover:border-smurf/30">
            <div class="text-4xl mb-4">{service.icon}</div>
            <h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
            <p class="text-gray-300 mb-4">{service.description}</p>
            {service.href && (
              <a href={service.href} class="text-smurf font-semibold hover:text-smurf-light transition-colors">
                Learn More &rarr;
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Sommer -->
  <section class="bg-dark px-6 py-20">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Why {name} Homeowners Choose Sommer Lawn</h2>
        <p class="text-gray-400 text-lg">We built this company around one idea — make it easy for you.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {differentiators.map((item) => (
          <div class="text-center">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-lg font-bold text-white mb-3">{item.title}</h3>
            <p class="text-gray-400 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials />

  <!-- Contact CTA -->
  <section id="contact" class="bg-dark-card px-6 py-20">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready for a Yard You're Proud Of?
      </h2>
      <p class="text-gray-400 text-lg mb-10">
        Reach out and we'll get back to you fast — usually within minutes.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="sms:+19132257717"
          class="inline-flex items-center gap-2 bg-smurf hover:bg-smurf-dark text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          Text Us
        </a>
        <a
          href="tel:+19132257717"
          class="inline-flex items-center gap-2 border border-dark-border hover:border-smurf/50 text-gray-300 hover:text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call (913) 225-7717
        </a>
      </div>

      <p class="text-gray-600 text-sm mt-8">
        Prefer email? Reach us at <a href="mailto:hello@sommerlawn.com" class="text-smurf hover:underline">hello@sommerlawn.com</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>

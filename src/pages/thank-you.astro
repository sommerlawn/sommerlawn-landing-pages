---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SignupForm from '../components/SignupForm.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    icon: '🏡',
    title: 'Mowing',
    slug: 'mowing',
    description: 'Weekly or bi-weekly mowing, trimming, and edging — your yard looking sharp all season.',
  },
  {
    icon: '🌿',
    title: 'Bed Maintenance',
    slug: 'bed-maintenance',
    description: 'Weed pulling, shrub trimming, and bed cleanup to keep your landscaping looking its best.',
  },
  {
    icon: '🪵',
    title: 'Mulch Installation',
    slug: 'mulch',
    description: 'Fresh mulch delivered and installed — clean edges, weed suppression, and instant curb appeal.',
  },
  {
    icon: '🌳',
    title: 'Tree Pruning',
    slug: 'tree-pruning',
    description: "Professional pruning for trees up to 20'. Healthier trees, cleaner sight lines, safer property.",
  },
  {
    icon: '🍂',
    title: 'Leaf Removal',
    slug: 'leaf-removal',
    description: "Full-service cleanup or curbside pickup — we handle the leaves so you don't have to.",
  },
  {
    icon: '❄️',
    title: 'Snow Removal',
    slug: 'snow-removal',
    description: "Driveways, sidewalks, and walkways cleared fast so you're never stuck after a storm.",
  },
];

const whyOneCompany = [
  {
    title: 'One Crew, One Relationship',
    description: 'No re-explaining your property. Your crew already knows your yard.',
  },
  {
    title: 'Seasonal Continuity',
    description: 'We transition seamlessly between services as the seasons change.',
  },
  {
    title: 'Simpler Billing',
    description: 'One company, one invoice. No juggling multiple contractors.',
  },
];
---

<Layout title="Thank You | Sommer Lawn & Landscape" noindex={true}>

  <Hero
    image="/truck+mower.jpeg"
    video="/general-b-roll.mp4"
    imagePosition="object-center"
    imageAlt="Sommer Lawn crew at work"
    prefixText="Thanks for"
    highlightText="Reaching Out!"
    headline=""
    subtitle="Here's what else we can do for you!"
    ctaText="See What Else We Do"
    ctaHref="#services"
    badge="Form Submitted"
    personalizedHeadline="Thanks, {name}!"
  />

  <!-- Service Upsell Grid -->
  <section id="services" class="bg-dark-card px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">While You Wait — Everything Else We Can Handle</h2>
        <p class="text-gray-400 text-lg">One company. One crew. Every season.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div
            class="bg-dark border border-dark-border rounded-xl p-8 transition-colors hover:border-smurf/30 relative"
            data-service={service.slug}
          >
            <span
              data-requested-badge
              class="hidden absolute top-4 right-4 bg-green-600 text-white text-xs font-semibold px-3 py-1 rounded-full"
            >
              Requested ✓
            </span>
            <div class="text-4xl mb-4">{service.icon}</div>
            <h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
            <p class="text-gray-300 mb-4">{service.description}</p>
            <a href="#signup" class="text-smurf font-semibold hover:text-smurf-light transition-colors">
              Add This Service &rarr;
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Bundle? -->
  <section class="bg-dark px-6 py-16">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">Why One Company?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {whyOneCompany.map((item) => (
          <div class="text-center">
            <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SignupForm />

  <section class="bg-dark-card px-6 py-12 text-center">
    <a href="/" class="text-gray-500 hover:text-white text-sm transition-colors">
      ← Back to Sommer Lawn & Landscape
    </a>
  </section>

  <Footer />

</Layout>

<script>
  // Break out of Zoho iframe if loaded inside one
  if (window !== window.top) {
    window.top.location.href = window.location.href;
  }

  const service = new URLSearchParams(window.location.search).get('service');
  if (service) {
    const card = document.querySelector(`[data-service="${service}"]`);
    card?.querySelector('[data-requested-badge]')?.classList.remove('hidden');
  }
</script>

---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SignupForm from '../components/SignupForm.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    icon: '🏡',
    title: 'Mowing',
    description: 'Weekly or bi-weekly mowing, trimming, and edging — your yard looking sharp all season.',
    href: '/mowing',
  },
  {
    icon: '🌿',
    title: 'Bed Maintenance',
    description: 'Weed pulling, shrub trimming, and bed cleanup to keep your landscaping looking its best.',
  },
  {
    icon: '🪵',
    title: 'Mulch Installation',
    description: 'Fresh mulch delivered and installed — clean edges, weed suppression, and instant curb appeal.',
  },
  {
    icon: '🌳',
    title: 'Tree Pruning',
    description: "Professional pruning for trees up to 20'. Healthier trees, cleaner sight lines, safer property.",
  },
  {
    icon: '🍂',
    title: 'Leaf Removal',
    description: "Full-service cleanup or curbside pickup — we handle the leaves so you don't have to.",
    href: '/leaf-removal',
  },
  {
    icon: '❄️',
    title: 'Snow Removal',
    description: "Driveways, sidewalks, and walkways cleared fast so you're never stuck after a storm.",
  },
];

const whyOneCompany = [
  {
    title: 'One Crew, One Relationship',
    description: 'No re-explaining your property. Your crew already knows your yard.',
  },
  {
    title: 'Seasonal Continuity',
    description: 'We transition seamlessly between services as the seasons change.',
  },
  {
    title: 'Simpler Billing',
    description: 'One company, one invoice. No juggling multiple contractors.',
  },
];
---

<Layout
  title="Our Services | Sommer Lawn & Landscape"
  description="Full-service lawn and landscape care in Johnson County, KS. Mowing, bed maintenance, mulch, tree pruning, leaf removal, and snow removal — one crew for every season."
>
  <Hero
    image="/truck+mower.jpeg"
    video="/general-b-roll.mp4"
    imagePosition="object-center"
    imageAlt="Sommer Lawn crew at work"
    prefixText="Let"
    headline="Take Care of All Your Landscape Needs"
    highlightText="Sommer Lawn"
    subtitle="Sit back, relax, and let us handle everything. Easy sign up, reliable service, outstanding team."
    ctaText="See Our Services"
    ctaHref="#services"
  />

  <!-- Services Grid -->
  <section id="services" class="bg-dark-card px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Everything Your Property Needs</h2>
        <p class="text-gray-400 text-lg">One company. One crew. Every season.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="bg-dark border border-dark-border rounded-xl p-8 transition-colors hover:border-smurf/30">
            <div class="text-4xl mb-4">{service.icon}</div>
            <h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
            <p class="text-gray-300 mb-4">{service.description}</p>
            {service.href && (
              <a href={service.href} class="text-smurf font-semibold hover:text-smurf-light transition-colors">
                Learn More &rarr;
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why One Company -->
  <section class="bg-dark px-6 py-20">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">Why One Company?</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {whyOneCompany.map((item) => (
          <div class="text-center">
            <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SignupForm />

  <Footer />
</Layout>

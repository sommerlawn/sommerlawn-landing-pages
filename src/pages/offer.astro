---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Your Sommer Lawn Offer"
  description="A personalized service offer from your Sommer Lawn crew."
  noindex={true}
>
  <!-- Header bar -->
  <header class="px-6 py-5 border-b border-dark-border bg-dark">
    <div class="max-w-4xl mx-auto">
      <p class="text-smurf font-bold text-xl">Sommer Lawn & Landscape</p>
    </div>
  </header>

  <!-- Hero greeting -->
  <section class="px-6 pt-14 pb-8 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 id="offer-greeting" class="text-3xl md:text-4xl font-bold text-white leading-tight mb-4">
        We noticed something at your property!
      </h1>
      <p class="text-gray-400 text-lg">Your Sommer Lawn crew put together this offer just for you.</p>
    </div>
  </section>

  <!-- Photo section -->
  <section id="offer-photo-section" class="px-6 pb-10" style="display:none">
    <div class="max-w-3xl mx-auto">
      <div class="relative rounded-2xl overflow-hidden bg-dark-card">
        <img
          id="offer-photo"
          src=""
          alt="Photo from your Sommer Lawn crew"
          class="w-full max-h-[480px] object-cover"
        />
        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-dark/80 to-transparent p-6">
          <p class="text-white text-sm font-medium">Photo taken by your crew during a recent visit</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Offer card -->
  <section class="px-6 pb-10">
    <div class="max-w-3xl mx-auto">
      <div class="bg-dark-card border border-dark-border rounded-2xl p-8">
        <p class="text-smurf text-sm font-semibold uppercase tracking-widest mb-3">Crew Recommendation</p>
        <h2 id="offer-service" class="text-2xl md:text-3xl font-bold text-white mb-5">
          Service Offer
        </h2>
        <p id="offer-desc" class="text-gray-400 text-lg leading-relaxed mb-8">
          Your crew noticed an opportunity to improve your property. Reply below and we'll get it scheduled.
        </p>
        <div class="border-t border-dark-border pt-6 flex items-center justify-between flex-wrap gap-4">
          <span class="text-gray-500 text-sm">One-time add-on service</span>
          <div class="flex items-baseline gap-1">
            <span id="offer-price-section" style="display:none">
              <span class="text-gray-400 text-xl">$</span><span id="offer-price" class="text-5xl font-bold text-smurf"></span>
            </span>
            <span id="offer-price-fallback" class="text-gray-400 text-lg">Contact us for pricing</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA / Form section -->
  <section class="px-6 pb-20">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-8">
        <h3 class="text-2xl font-bold text-white mb-3">Ready to get it done?</h3>
        <p class="text-gray-400">Fill out the form below and we'll get it scheduled.</p>
      </div>

      <!-- Zoho service request form -->
      <div class="bg-smurf rounded-2xl p-6 md:p-10 mb-8">
        <div id="zf_div_muOCT3gdrMs257uLZAK9pZTRlLHxlwH6qFdPbiG_49Y" class="w-full max-w-2xl mx-auto"></div>
      </div>

      <!-- Divider -->
      <div class="flex items-center gap-4 mb-8">
        <div class="flex-1 border-t border-dark-border"></div>
        <span class="text-gray-600 text-sm">or reach us directly</span>
        <div class="flex-1 border-t border-dark-border"></div>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          id="offer-sms"
          href="sms:+19132257717"
          class="inline-flex items-center gap-2 bg-smurf hover:bg-smurf-dark text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors w-full sm:w-auto justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          Text to Schedule
        </a>
        <a
          href="tel:+19132257717"
          class="inline-flex items-center gap-2 border border-dark-border hover:border-smurf/50 text-gray-300 hover:text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors w-full sm:w-auto justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call (913) 225-7717
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var customer = params.get('customer');
    var service  = params.get('service');
    var price    = params.get('price');
    var photo    = params.get('photo');
    var desc     = params.get('desc');

    // Greeting
    if (customer) {
      var greeting = document.getElementById('offer-greeting');
      if (greeting) {
        greeting.textContent = 'Hey ' + customer + ', we noticed something at your property!';
      }
    }

    // Photo
    if (photo) {
      var photoEl = document.getElementById('offer-photo');
      var photoSection = document.getElementById('offer-photo-section');
      if (photoEl && photoSection) {
        photoEl.src = photo;
        photoEl.onerror = function () {
          photoSection.style.display = 'none';
        };
        photoSection.style.display = '';
      }
    }

    // Service name
    if (service) {
      var serviceEl = document.getElementById('offer-service');
      if (serviceEl) serviceEl.textContent = service;
    }

    // Description
    if (desc) {
      var descEl = document.getElementById('offer-desc');
      if (descEl) descEl.textContent = desc;
    }

    // Price
    if (price) {
      var priceEl      = document.getElementById('offer-price');
      var priceSection = document.getElementById('offer-price-section');
      var priceFallback = document.getElementById('offer-price-fallback');
      if (priceEl && priceSection && priceFallback) {
        priceEl.textContent = price;
        priceSection.style.display = '';
        priceFallback.style.display = 'none';
      }
    }

    // SMS pre-fill
    var smsEl = document.getElementById('offer-sms');
    if (smsEl) {
      var body = "Hi! I'd like to schedule";
      if (service) body += ' ' + service;
      if (price)   body += ' for $' + price;
      body += '. Can you get that added to my next visit?';
      smsEl.href = 'sms:+19132257717?body=' + encodeURIComponent(body);
    }

    // Zoho service request form
    try {
      var ifrmSrc = 'https://forms.zohopublic.com/sommerlawn/form/ServiceRequestFormexistingcustomers/formperma/muOCT3gdrMs257uLZAK9pZTRlLHxlwH6qFdPbiG_49Y?zf_rszfm=1';

      // Pass offer params through to the form so Zoho can pre-populate fields
      params.forEach(function(value, key) {
        if (key !== 'zf_rszfm') {
          ifrmSrc += '&' + encodeURIComponent(key) + '=' + encodeURIComponent(value);
        }
      });

      var f = document.createElement('iframe');
      f.src = ifrmSrc;
      f.style.border = 'none';
      f.style.height = '823px';
      f.style.width = '100%';
      f.style.display = 'block';
      f.style.borderRadius = '1rem';
      f.style.transition = 'all 0.5s ease';
      f.setAttribute('allowfullscreen', 'true');
      f.setAttribute('allow', 'geolocation;');
      f.setAttribute('aria-label', 'Service Request Form');

      var divId = 'zf_div_muOCT3gdrMs257uLZAK9pZTRlLHxlwH6qFdPbiG_49Y';
      var d = document.getElementById(divId);
      if (d) d.appendChild(f);

      window.addEventListener('message', function(event) {
        var evntData = event.data;
        if (evntData && evntData.constructor === String) {
          var zf_ifrm_data = evntData.split('|');
          if (zf_ifrm_data.length === 2 || zf_ifrm_data.length === 3) {
            var zf_perma = zf_ifrm_data[0];
            var zf_ifrm_ht_nw = (parseInt(zf_ifrm_data[1], 10) + 15) + 'px';
            var container = document.getElementById(divId);
            if (!container) return;
            var iframe = container.getElementsByTagName('iframe')[0];
            if (iframe && iframe.src.indexOf('formperma') > 0 && iframe.src.indexOf(zf_perma) > 0) {
              var prevHeight = iframe.style.height;
              if (zf_ifrm_data.length === 3) {
                iframe.scrollIntoView();
                if (prevHeight !== zf_ifrm_ht_nw) setTimeout(function() { iframe.style.height = zf_ifrm_ht_nw; }, 500);
              } else {
                if (prevHeight !== zf_ifrm_ht_nw) iframe.style.height = zf_ifrm_ht_nw;
              }
            }
          }
        }
      }, false);
    } catch(e) {}
  })();
</script>

---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ValueProps from '../components/ValueProps.astro';
import SignupForm from '../components/SignupForm.astro';
import Footer from '../components/Footer.astro';

const snowValueProps = [
  {
    icon: '⚡',
    title: 'Fast Response',
    feature: 'We move quickly after every storm.',
    benefit: 'We know you need to get out. We prioritize getting to your property fast so you\'re not stuck waiting.',
  },
  {
    icon: '🛣️',
    title: 'Driveways & Walkways',
    feature: 'Full property coverage.',
    benefit: 'Driveway, sidewalks, and walkways all cleared — not just the bare minimum to get by.',
  },
  {
    icon: '🧂',
    title: 'Salt & Ice Treatment',
    feature: 'Safer surfaces after clearing.',
    benefit: 'We treat surfaces after clearing so ice doesn\'t reform and you\'re not slipping the next morning.',
  },
  {
    icon: '📱',
    title: 'Text Reminders',
    feature: 'Get notified when we\'re on the way.',
    benefit: 'We\'ll let you know when we\'re headed to your property so you\'re never caught off guard.',
  },
  {
    icon: '💳',
    title: 'Card on File',
    feature: 'Automatic charge after each visit.',
    benefit: 'No invoices to track down. You get a receipt in your email after every service.',
  },
  {
    icon: '💬',
    title: 'Text Us Anytime',
    feature: 'Quick communication, no phone tag.',
    benefit: 'Shoot us a text to schedule, ask questions, or request a rush visit — we respond fast.',
  },
];
---

<Layout
  title="Snow Removal | Sommer Lawn & Landscape"
  description="Fast snow removal in Johnson County, KS. Driveways, sidewalks, and walkways cleared after every storm."
>
  <Hero
    image="/normal-mower.png"
    imagePosition="object-top"
    imageAlt="Sommer Lawn ready for winter service"
    headline="Snow Removal"
    highlightText="Sommer Lawn"
    prefixText="Winter Service by"
    subtitle="Driveways, sidewalks, and walkways cleared fast — so you're never stuck after a storm."
    ctaText="Get a Quote"
    ctaHref="#signup"
  />

  <!-- What we clear -->
  <section class="bg-dark px-6 py-20">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-3">What We Clear</h2>
      <p class="text-gray-400 text-center text-lg mb-12">Full property coverage after every storm.</p>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-dark-card border border-dark-border rounded-xl p-6 text-center">
          <div class="text-4xl mb-4">🚗</div>
          <h3 class="text-white font-bold text-lg mb-2">Driveway</h3>
          <p class="text-gray-400 text-sm">Fully cleared so you can get in and out without issue.</p>
        </div>
        <div class="bg-dark-card border border-dark-border rounded-xl p-6 text-center">
          <div class="text-4xl mb-4">🚶</div>
          <h3 class="text-white font-bold text-lg mb-2">Sidewalks</h3>
          <p class="text-gray-400 text-sm">Front walk and public sidewalk cleared and treated.</p>
        </div>
        <div class="bg-dark-card border border-dark-border rounded-xl p-6 text-center">
          <div class="text-4xl mb-4">🧂</div>
          <h3 class="text-white font-bold text-lg mb-2">Ice Treatment</h3>
          <p class="text-gray-400 text-sm">Salt applied after clearing to prevent refreezing.</p>
        </div>
      </div>
    </div>
  </section>

  <ValueProps
    title="Why Choose Sommer Lawn?"
    subtitle="Fast, reliable snow removal so you're never stuck after a storm."
    items={snowValueProps}
  />

  <SignupForm />

  <!-- More Services -->
  <section class="bg-dark-card px-6 py-16 text-center">
    <p class="text-gray-400 text-lg mb-4">We do more than snow removal.</p>
    <a href="/services" class="text-smurf font-semibold text-lg hover:text-smurf-light transition-colors">
      View All Services &rarr;
    </a>
  </section>

  <Footer />
</Layout>

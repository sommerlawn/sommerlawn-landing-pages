---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PriceDisplay from '../components/PriceDisplay.astro';
import ValueProps from '../components/ValueProps.astro';
import Testimonials from '../components/Testimonials.astro';
import SignupForm from '../components/SignupForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Add Mowing Service | Sommer Lawn & Landscape"
  description="Add weekly or bi-weekly mowing to your Sommer Lawn services. Same crew, same quality, zero hassle."
>
  <Hero video="/mowing-b-roll.mp4" ctaText="Claim Your Free Mow" ctaHref="#offer" />
  <PriceDisplay />

  <!-- 2nd Mow Free Offer -->
  <section id="offer" class="bg-dark px-6 py-20">
    <div class="max-w-3xl mx-auto text-center">
      <div class="inline-block bg-smurf/20 border border-smurf/40 text-smurf text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-4">
        Limited-Time Offer
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Your 2nd Mow Free</h2>
      <p class="text-gray-400 text-lg mb-12">Sign up for mowing service and we'll take care of your 2nd mow — completely free. No contracts, easy cancel anytime.</p>

      <div class="grid grid-cols-2 gap-2 sm:gap-3 mb-10 max-w-sm mx-auto">
        <div class="bg-dark-card border border-dark-border rounded-xl sm:rounded-2xl p-3 sm:p-5">
          <p class="text-gray-400 font-bold text-[10px] sm:text-xs uppercase tracking-wide sm:tracking-widest mb-1 sm:mb-2">Mow 1</p>
          <p class="text-lg sm:text-2xl font-extrabold text-white">Paid</p>
          <p class="text-gray-500 text-[10px] sm:text-xs mt-1 leading-tight">Regular rate</p>
        </div>
        <div class="bg-dark-card border border-smurf/40 rounded-xl sm:rounded-2xl p-3 sm:p-5 ring-1 ring-smurf/20">
          <p class="text-smurf font-bold text-[10px] sm:text-xs uppercase tracking-wide sm:tracking-widest mb-1 sm:mb-2">Mow 2</p>
          <p class="text-lg sm:text-2xl font-extrabold text-white">FREE</p>
          <p class="text-gray-500 text-[10px] sm:text-xs mt-1 leading-tight">On us</p>
        </div>
      </div>

      <ul class="text-gray-500 text-sm mb-8 block mx-auto w-fit text-left space-y-1">
        <li class="flex items-start gap-2"><span>•</span>An overgrown fee may apply if the lawn requires extra work on the first visit</li>
        <li class="flex items-start gap-2"><span>•</span>Offer expires March 31, 2026</li>
      </ul>
      <a
        href="#signup"
        class="inline-block bg-smurf hover:bg-smurf-dark text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors"
      >
        Claim This Offer
      </a>
    </div>
  </section>

  <ValueProps />

  <!-- Full-width photo break -->
  <div class="relative h-64 md:h-80 lg:h-96 overflow-hidden">
    <img src="/normal-mower.png" alt="Sommer Lawn mowing crew at work" class="w-full h-full object-cover object-[30%_top]" />
    <div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-transparent to-dark/30"></div>
  </div>

  <Testimonials />

  <SignupForm />

  <!-- Full-width photo break -->
  <div class="relative h-64 md:h-80 lg:h-96 overflow-hidden">
    <img src="/mower-close-up.png" alt="Close-up of Sommer Lawn mower on fresh-cut grass" class="w-full h-full object-cover object-top" />
    <div class="absolute inset-0 bg-gradient-to-b from-dark/30 via-transparent to-dark/30"></div>
  </div>

  <!-- More Services -->
  <section class="bg-dark-card px-6 py-16 text-center">
    <p class="text-gray-400 text-lg mb-4">We do more than mowing.</p>
    <a href="/services" class="text-smurf font-semibold text-lg hover:text-smurf-light transition-colors">
      View All Services &rarr;
    </a>
  </section>

  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import SignupForm from '../components/SignupForm.astro';
import Footer from '../components/Footer.astro';

const rounds = [
  {
    number: 1,
    name: 'Early Spring',
    timing: 'Done by 1st week of April',
    standard: ['Slow-release granular fertilizer', 'Pre-emergent crabgrass control'],
    eco: ['Slow-release fertilizer'],
  },
  {
    number: 2,
    name: 'Late Spring',
    timing: 'Late May',
    standard: ['Broadleaf weed control spray (dandelions, clover & more)'],
    eco: [],
  },
  {
    number: '3 & 4',
    name: 'Summer',
    timing: 'June – Mid July',
    note: '2 applications, 1 visit',
    standard: ['Slow-release granular fertilizer', 'Preventative grub control'],
    eco: ['Fertilizer'],
  },
  {
    number: 5,
    name: 'Fall Fertilizer',
    timing: 'September',
    standard: ['Granular fertilizer with rooting hormone', 'Promotes deep root development heading into winter'],
    eco: ['Fertilizer'],
  },
  {
    number: 6,
    name: 'Fall Weed Control',
    timing: 'Late September – October',
    standard: ['Broadleaf weed control spray'],
    eco: [],
  },
  {
    number: 7,
    name: 'Winterizer',
    timing: 'Mid October – November',
    standard: ['High-nitrogen granular winterizer fertilizer'],
    eco: ['Winterizer fertilizer'],
  },
];
---

<Layout
  title="Lawn Applications | Sommer Lawn & Landscape"
  description="A 7-round lawn program for Johnson County, KS. Choose our Standard or Eco program — the Eco option uses no herbicides, pesticides, or insecticides."
>

  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-center justify-center px-6 py-20">
    <div class="absolute inset-0">
      <img src="/normal-mower.png" alt="Healthy green lawn" class="w-full h-full object-cover object-top" />
      <div class="absolute inset-0 bg-gradient-to-b from-dark/60 via-dark/55 to-dark"></div>
    </div>
    <div class="relative z-10 max-w-3xl mx-auto text-center mt-16 md:mt-0">
      <h1 id="hero-heading" class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
        Lawn Application<br /><span class="text-smurf">Programs</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
        A 7-round seasonal program to keep your lawn thick, green, and healthy all year — with a chemical-free Eco option coming soon.
      </p>
      <a
        href="#signup"
        class="inline-block bg-smurf hover:bg-smurf-dark text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors"
      >
        Get Started
      </a>
    </div>
  </section>

  <!-- Personalized Price Display -->
  <section id="price-display" class="hidden bg-dark px-6 py-16">
    <div class="max-w-sm mx-auto text-center">
      <p class="text-gray-400 text-lg mb-8">Your personalized lawn applications price</p>
      <div class="border border-smurf/30 rounded-2xl px-8 py-10 shadow-[0_0_30px_rgba(0,174,239,0.1)]">
        <p class="text-gray-400 text-sm uppercase tracking-wide mb-3">Per Round</p>
        <div class="mb-3">
          <span class="text-smurf text-2xl font-semibold align-top">$</span>
          <span id="price-amount" class="text-smurf text-6xl md:text-7xl font-bold"></span>
          <span class="text-gray-400 text-lg">/round</span>
        </div>
        <p class="text-gray-500 text-sm mb-6">7 rounds per year — fertilization, weed control, and grub prevention</p>
        <a href="#signup" class="inline-block bg-smurf hover:bg-smurf-dark text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors">
          Sign Up Today
        </a>
      </div>
    </div>
  </section>

  <!-- Program Comparison -->
  <section class="bg-dark-card px-6 py-20">
    <div class="max-w-4xl mx-auto text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Choose Your Program</h2>
      <p class="text-gray-400 text-lg">Two programs, two different approaches.</p>
    </div>
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-8">

      <!-- Standard Program -->
      <div class="bg-dark border border-dark-border rounded-2xl overflow-hidden flex flex-col">
        <div class="bg-smurf px-6 py-5 text-center">
          <h3 class="text-white font-extrabold text-xl uppercase tracking-wide">Standard Program</h3>
          <p class="text-white/80 text-sm mt-1">Fertilization + full weed & pest control</p>
        </div>
        <div class="p-8 flex flex-col flex-1">
          <ul class="space-y-3 mb-6">
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Seasonal fertilizer applications
            </li>
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Pre-emergent weed control (spring)
            </li>
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Broadleaf weed control
            </li>
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Preventative grub control (summer)
            </li>
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Fall fertilizer with rooting hormone
            </li>
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-smurf font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              High-nitrogen winterizer
            </li>
          </ul>
          <p class="text-gray-500 text-sm mt-auto">Best for: most lawns, maximum weed and pest suppression</p>
        </div>
      </div>

      <!-- Healthy / Environmental Program -->
      <div class="relative">
      <div class="bg-dark border border-dark-border rounded-2xl overflow-hidden flex flex-col opacity-40 pointer-events-none select-none">
        <div class="bg-gradient-to-r from-green-700 to-green-600 px-6 py-5 text-center">
          <div class="flex items-center justify-center gap-3">
            <h3 class="text-white font-extrabold text-xl uppercase tracking-wide">Eco Program</h3>
          </div>
          <p class="text-white/80 text-sm mt-1">Organic &amp; chemical-free</p>
        </div>
        <div class="p-8 flex flex-col flex-1">
          <div class="inline-flex items-center gap-2 bg-green-900/40 border border-green-700/40 text-green-400 text-xs font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-5 self-start">
            🌱 No herbicides &middot; No insecticides &middot; No pesticides
          </div>
          <ul class="space-y-3 mb-6">
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-green-400 font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Slow-release fertilizer
            </li>
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-green-400 font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Safe for kids, pets, and pollinators
            </li>
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-green-400 font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Builds long-term soil health
            </li>
            <li class="flex items-start gap-3 text-gray-300">
              <span class="text-green-400 font-bold text-lg flex-shrink-0 leading-snug">✓</span>
              Fall winterizer
            </li>
          </ul>
          <p class="text-gray-500 text-sm mt-auto">Best for: families with kids, pets, or environmentally conscious homeowners</p>
        </div>
      </div>
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <span class="bg-dark/80 border border-green-700/40 text-green-400 text-sm font-bold uppercase tracking-widest px-6 py-3 rounded-full shadow-lg">
          Coming Soon
        </span>
      </div>
      </div>

      </div>
    </div>
  </section>

  <!-- 7-Round Schedule -->
  <section class="bg-dark px-6 py-20">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-3">The 7-Round Schedule</h2>
      <p class="text-gray-400 text-center text-lg mb-12">Timed perfectly for Johnson County's seasons.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {rounds.map((round) => (
          <div class="bg-dark-card border border-dark-border rounded-xl p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="h-9 min-w-[2.25rem] px-2 rounded-full bg-smurf/20 border border-smurf/40 flex items-center justify-center flex-shrink-0">
                <span class="text-smurf font-extrabold text-sm whitespace-nowrap">{round.number}</span>
              </div>
              <div>
                <p class="text-white font-bold leading-tight">{round.name}</p>
                <p class="text-gray-500 text-xs">{round.timing}{round.note ? ` · ${round.note}` : ''}</p>
              </div>
            </div>
            <div class="space-y-3">
              <div>
                <p class="text-smurf text-xs font-bold uppercase tracking-widest mb-1.5">Standard</p>
                <ul class="space-y-1">
                  {round.standard.map(item => (
                    <li class="text-gray-400 text-sm flex items-start gap-1.5">
                      <span class="text-smurf/60 flex-shrink-0 mt-0.5">•</span>{item}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="border-t border-dark-border pt-2 mt-1">
                <div class="flex items-center gap-1.5 mb-1">
                  <p class="text-green-600 text-[10px] font-bold uppercase tracking-widest">Eco</p>
                  <span class="bg-green-900/50 border border-green-700/40 text-green-600 text-[9px] font-bold uppercase tracking-widest px-1.5 py-0.5 rounded-full">Coming Soon</span>
                </div>
                {round.eco.length > 0 ? (
                  <ul class="space-y-0.5">
                    {round.eco.map(item => (
                      <li class="text-gray-600 text-xs flex items-start gap-1.5">
                        <span class="text-green-700/60 flex-shrink-0 mt-0.5">•</span>{item}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-gray-700 text-xs italic">No application this round</p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SignupForm />

  <!-- More Services -->
  <section class="bg-dark px-6 py-16 text-center">
    <p class="text-gray-400 text-lg mb-4">Looking for other services?</p>
    <a href="/services" class="text-smurf font-semibold text-lg hover:text-smurf-light transition-colors">
      View All Services &rarr;
    </a>
  </section>

  <Footer />
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const name = params.get('first');
  const priceRaw = params.get('price');

  if (name) {
    const heading = document.getElementById('hero-heading');
    if (heading) {
      if (priceRaw) {
        heading.innerHTML = `Hey ${name}! Check out your personalized<br />Lawn Applications price from <span class="text-smurf">Sommer Lawn</span>.`;
      } else {
        heading.innerHTML = `Hey ${name}! Check out <span class="text-smurf">Sommer Lawn's</span> Lawn Application Programs`;
      }
    }
  }

  if (priceRaw) {
    const sanitized = priceRaw.replace(/[^\d.]/g, '');
    const formatted = sanitized.includes('.') ? parseFloat(sanitized).toFixed(2) : sanitized;
    if (formatted && !isNaN(Number(formatted))) {
      const section = document.getElementById('price-display');
      const amount = document.getElementById('price-amount');
      if (section && amount) {
        amount.textContent = formatted;
        section.classList.remove('hidden');
      }
    }
  }
</script>


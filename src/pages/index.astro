---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    icon: '🏡',
    title: 'Mowing',
    description: 'Weekly or bi-weekly mowing, trimming, edging, and blowing — same crew, sharp results, all season long.',
    href: '/mowing',
  },
  {
    icon: '🌿',
    title: 'Bed Maintenance',
    description: 'Regular weed pulling and shrub trimming to keep your beds looking sharp all season.',
    href: '/bed-maintenance',
  },
  {
    icon: '🪵',
    title: 'Mulch Installation',
    description: 'Fresh mulch delivered and installed — clean edges, weed suppression, and instant curb appeal.',
    href: '/mulch',
  },
  {
    icon: '🌳',
    title: 'Tree Pruning',
    description: "Professional pruning for trees up to 20'. Healthier trees, cleaner sight lines, safer property.",
    href: '/tree-pruning',
  },
  {
    icon: '🍂',
    title: 'Leaf Removal',
    description: "Full-service cleanup or curbside pickup — we handle the leaves so you don't have to.",
    href: '/leaf-removal',
  },
  {
    icon: '❄️',
    title: 'Snow Removal',
    description: "Driveways, sidewalks, and walkways cleared fast so you're never stuck after a storm.",
    href: '/snow-removal',
  },
  {
    icon: '🌱',
    title: 'Lawn Applications',
    description: 'A 7-round seasonal program — Standard or chemical-free Eco option. No herbicides, no pesticides.',
    href: '/lawn-applications',
  },
];

const differentiators = [
  {
    icon: '✅',
    title: 'Actually Reliable',
    description: 'We show up when we say we will. If something ever changes, we reach out — you\'re never left wondering where your crew is.',
  },
  {
    icon: '🤝',
    title: 'One Crew, All Season',
    description: 'Your same crew handles mowing, leaves, and snow. They know your property — no re-explaining every visit.',
  },
  {
    icon: '📱',
    title: 'Easy to Work With',
    description: 'Text us, call us, or fill out a form. Fast responses, straightforward pricing, and no-hassle billing.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Reach Out',
    description: 'Text or call us with your address and what you need. Takes about 2 minutes.',
  },
  {
    number: '02',
    title: 'Get a Quote',
    description: "We'll give you a fair, upfront price. No pressure, no hidden fees.",
  },
  {
    number: '03',
    title: 'We Take It From Here',
    description: 'Your crew shows up and gets it done. Simple as that.',
  },
];

const cities = [
  { name: 'Prairie Village', slug: 'prairie-village' },
  { name: 'Mission Hills', slug: 'mission-hills' },
  { name: 'Fairway', slug: 'fairway' },
  { name: 'Mission', slug: 'mission' },
  { name: 'Roeland Park', slug: 'roeland-park' },
  { name: 'Overland Park', slug: 'overland-park' },
  { name: 'Leawood', slug: 'leawood' },
  { name: 'Olathe', slug: 'olathe' },
];
---

<Layout
  title="Sommer Lawn & Landscape | Johnson County, KS"
  description="Reliable lawn care and landscape services in Johnson County, KS. Mowing, leaf removal, mulch, snow removal, and more. Same crew. Honest pricing. Text us today."
>

  <Nav />

  <Hero
    image="/truck+mower.jpeg"
    video="/general-b-roll(edited).mp4"
    imagePosition="object-center"
    imageAlt="Sommer Lawn crew at work in Johnson County KS"
    prefixText=""
    headline="A Lawn Service You Can Rely On"
    highlightText="Sommer Lawn —"
    subtitle="Full-service lawn and landscape care for Johnson County homeowners. Same crew, honest pricing, no headaches."
    ctaText="Get a Free Quote"
    ctaHref="#contact"
  />

  <!-- Trust Bar -->
  <section class="bg-smurf px-6 py-5">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div>
          <p class="text-white font-bold text-2xl">6k+</p>
          <p class="text-white/80 text-sm">Lawns Mowed</p>
        </div>
        <div>
          <p class="text-white font-bold text-2xl">400+</p>
          <p class="text-white/80 text-sm">Customers Served</p>
        </div>
        <div>
          <p class="text-white font-bold text-2xl">★ 5.0</p>
          <p class="text-white/80 text-sm">Average Rating</p>
        </div>
        <div>
          <p class="text-white font-bold text-2xl">3+</p>
          <p class="text-white/80 text-sm">Years in Johnson County</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="bg-dark-card px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Everything Your Property Needs</h2>
        <p class="text-gray-400 text-lg">One company. One crew. Every season.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="bg-dark border border-dark-border rounded-xl p-8 transition-colors hover:border-smurf/30 flex flex-col">
            <div class="flex items-start justify-between gap-2 mb-4">
              <span class="text-4xl">{service.icon}</span>
              {service.badge && (
                <span class="inline-block bg-smurf/20 border border-smurf/40 text-smurf text-[10px] font-bold uppercase tracking-widest px-2 py-1 rounded-full flex-shrink-0 mt-1">
                  {service.badge}
                </span>
              )}
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{service.title}</h3>
            <p class="text-gray-300 mb-4 flex-1">{service.description}</p>
            {service.href && (
              <a href={service.href} class="text-smurf font-semibold hover:text-smurf-light transition-colors">
                Learn More &rarr;
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Sommer -->
  <section class="bg-dark px-6 py-20">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Why Homeowners Choose Sommer Lawn</h2>
        <p class="text-gray-400 text-lg">We built this company around one idea — make it easy for you.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {differentiators.map((item) => (
          <div class="text-center">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-lg font-bold text-white mb-3">{item.title}</h3>
            <p class="text-gray-400 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="bg-dark-card px-6 py-20">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Getting Started Is Easy</h2>
        <p class="text-gray-400 text-lg">No complicated process. No long contracts. Just great service.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-10">
        {steps.map((step) => (
          <div class="relative text-center">
            <div class="text-5xl font-bold text-smurf/20 mb-3 leading-none">{step.number}</div>
            <h3 class="text-lg font-bold text-white mb-2">{step.title}</h3>
            <p class="text-gray-400 leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials />

  <!-- Service Area -->
  <section class="bg-dark px-6 py-20">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Serving Johnson County, KS</h2>
      <p class="text-gray-400 text-lg mb-10">We work in most of Johnson County, with a focus on these communities:</p>
      <div class="flex flex-wrap justify-center gap-3">
        {cities.map((city) => (
          <a
            href={`/${city.slug}`}
            class="bg-dark-card border border-dark-border hover:border-smurf/50 text-gray-300 hover:text-white px-4 py-2 rounded-full text-sm transition-colors"
          >
            {city.name} &rarr;
          </a>
        ))}
      </div>
      <p class="text-gray-500 text-sm mt-8">Not sure if we cover your area? Just text us — we'll let you know.</p>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="contact" class="bg-dark-card px-6 py-20">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready for a Yard You're Proud Of?
      </h2>
      <p class="text-gray-400 text-lg mb-10">
        Reach out and we'll get back to you fast — usually within minutes.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="sms:+19132257717"
          class="inline-flex items-center gap-2 bg-smurf hover:bg-smurf-dark text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          Text Us
        </a>
        <a
          href="tel:+19132257717"
          class="inline-flex items-center gap-2 border border-dark-border hover:border-smurf/50 text-gray-300 hover:text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call (913) 225-7717
        </a>
      </div>

      <p class="text-gray-600 text-sm mt-8">
        Prefer email? Reach us at <a href="mailto:hello@sommerlawn.com" class="text-smurf hover:underline">hello@sommerlawn.com</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>

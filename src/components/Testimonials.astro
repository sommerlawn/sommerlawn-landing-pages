---
// Placeholder testimonials — replace with real customer quotes
const testimonials = [
  {
    quote: 'Customer testimonial placeholder — replace with a real quote from a mowing customer.',
    name: 'Customer Name',
    location: 'Overland Park, KS',
  },
  {
    quote: 'Customer testimonial placeholder — replace with a real quote from a mowing customer.',
    name: 'Customer Name',
    location: 'Prairie Village, KS',
  },
];
---

<section class="px-6 py-20 bg-dark-card">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-14">
      What Our Customers Say
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      {testimonials.map((t) => (
        <div class="bg-dark border border-dark-border rounded-xl p-8">
          <div class="text-smurf text-3xl mb-4">"</div>
          <p class="text-gray-300 leading-relaxed mb-6">{t.quote}</p>
          <div>
            <p class="text-white font-semibold">{t.name}</p>
            <p class="text-gray-500 text-sm">{t.location}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

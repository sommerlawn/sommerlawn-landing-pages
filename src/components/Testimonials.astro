---
interface Testimonial {
  quote: string;
  name: string;
  stars: number;
}

interface Props {
  testimonials?: Testimonial[];
  video?: string;
}

const defaultTestimonials: Testimonial[] = [
  {
    quote: 'The crew did a great job! They were able to come within the same day of the request and had all of the leaves cleaned up in less than 30 minutes or so! Very appreciative of their work.',
    name: 'Logan J.',
    stars: 5,
  },
  {
    quote: 'Prompt response and very punctual in completing the work requested. Cayden was extremely helpful in squeezing the job in on the Holiday week of Thanksgiving. Highly recommend the lawn service!!!',
    name: 'John Peter S.',
    stars: 5,
  },
  {
    quote: 'My mower needed servicing, and Sommer Lawn was recommended. I\'m sticking with them through the rest of the year! Saves me a lot of time every week, and I love the sharp edging.',
    name: 'Rachel M.',
    stars: 5,
  },
];

const { testimonials = defaultTestimonials, video } = Astro.props;
---

<section class="relative px-6 py-20 bg-dark-card overflow-hidden">
  {video && (
    <video autoplay muted loop playsinline class="absolute inset-0 w-full h-full object-cover">
      <source src={video} type="video/mp4" />
    </video>
  )}
  {video && <div class="absolute inset-0 bg-dark/80"></div>}
  <div class="relative max-w-5xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-14">
      What Our Customers Say
    </h2>

    <div class={`grid gap-8 ${testimonials.length === 2 ? 'md:grid-cols-2 max-w-3xl mx-auto' : 'md:grid-cols-3'}`}>
      {testimonials.map((t) => (
        <div class="bg-dark/70 border border-dark-border rounded-xl p-6 max-w-sm mx-auto">
          <div class="flex gap-1 mb-4">
            {Array.from({ length: t.stars }).map(() => (
              <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
          <p class="text-gray-300 leading-relaxed mb-6">{t.quote}</p>
          <p class="text-white font-semibold">{t.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>

---
interface Props {
  image?: string;
  imagePosition?: string;
  imageAlt?: string;
  video?: string;
  headline?: string;
  highlightText?: string;
  subtitle?: string;
  ctaText?: string;
  prefixText?: string;
  ctaHref?: string;
  personalizedHeadline?: string;
  personalizedHeadlineNoPrice?: string;
  badge?: string;
}

const {
  image = '/normal-mower.png',
  imagePosition = 'object-[30%_top]',
  imageAlt = 'Sommer Lawn mowing crew at work',
  video,
  headline = 'Mowing Service',
  highlightText = "Sommer Lawn's",
  subtitle = 'Weekly or bi-weekly — same crew, same quality, zero hassle. Mowing, trimming, edging, and blowing off all concrete surfaces.',
  prefixText = 'Sign Up for',
  ctaText = 'Sign Up',
  ctaHref = '#signup',
  personalizedHeadline = `Hey {name}! Check out your personalized<br />Mowing price from <span class="text-smurf">Sommer Lawn</span>.`,
  personalizedHeadlineNoPrice = `Hey {name}! Check out <span class="text-smurf">Sommer Lawn's</span> Mowing Service`,
  badge,
} = Astro.props;
---

<section class="relative min-h-[70vh] flex items-center justify-center px-6 py-20">
  <!-- Hero background -->
  <div class="absolute inset-0">
    {video ? (
      <>
        <img src={image} alt={imageAlt} class={`absolute inset-0 w-full h-full object-cover ${imagePosition}`} />
        <video autoplay muted loop playsinline class={`absolute inset-0 w-full h-full object-cover ${imagePosition}`}>
          <source src={video} type="video/mp4" />
        </video>
      </>
    ) : (
      <img src={image} alt={imageAlt} class={`w-full h-full object-cover ${imagePosition}`} />
    )}
    <div class="absolute inset-0 bg-gradient-to-b from-dark/60 via-dark/50 to-dark"></div>
  </div>

  <div class="relative z-10 max-w-3xl mx-auto text-center mt-16 md:mt-0">
    {badge && (
      <span class="inline-block bg-smurf text-white text-sm font-semibold px-4 py-1.5 rounded-full mb-6 uppercase tracking-wide">
        {badge}
      </span>
    )}
    <h1 id="hero-heading" class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
      {prefixText && <span id="hero-prefix">{prefixText} </span>}
      <span class="text-smurf">{highlightText}</span> {headline}
    </h1>

    <p class="text-lg md:text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
      {subtitle}
    </p>

    <a
      href={ctaHref}
      class="inline-block bg-smurf hover:bg-smurf-dark text-white font-semibold text-lg px-8 py-4 rounded-lg transition-colors"
    >
      {ctaText}
    </a>
  </div>
</section>

<script is:inline define:vars={{ personalizedHeadline, personalizedHeadlineNoPrice }}>
  const params = new URLSearchParams(window.location.search);
  const name = params.get('first');
  if (name) {
    const heading = document.getElementById('hero-heading');
    if (heading) {
      // The headline templates contain markup, so they go in via innerHTML —
      // escape the URL-supplied name so it can't inject any of its own.
      const safeName = name.replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[c]);
      const template = params.get('price') ? personalizedHeadline : personalizedHeadlineNoPrice;
      heading.innerHTML = template.replace('{name}', safeName);
    }
  }
</script>

---
const steps = [
  {
    number: '1',
    title: 'Choose Your Schedule',
    description: 'Pick weekly or bi-weekly mowing — whatever fits your lawn and budget.',
  },
  {
    number: '2',
    title: 'We Handle the Rest',
    description: 'Mowing, trimming, edging, and blowing off all concrete surfaces. Every visit.',
  },
  {
    number: '3',
    title: 'Stay in the Loop',
    description: 'Get a text before each visit. Card charged after service. Receipt in your email.',
  },
];
---

<section class="px-6 py-20">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-14">
      How It Works
    </h2>

    <div class="grid md:grid-cols-3 gap-8">
      {steps.map((step) => (
        <div class="text-center">
          <div class="w-14 h-14 rounded-full bg-smurf/10 border-2 border-smurf text-smurf font-bold text-xl flex items-center justify-center mx-auto mb-5">
            {step.number}
          </div>
          <h3 class="text-lg font-semibold text-white mb-3">{step.title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
